# Copy this to .env and fill in as needed. All values here already have
# sane defaults in docker-compose.yml, so the app runs out of the box
# without an API key.

SECRET_KEY=please-change-this-to-something-random
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/watchlist
REDIS_URL=redis://redis:6379/0

# Optional: get a free key at https://twelvedata.com/ for real (delayed)
# live quotes during market hours. If left blank, the system automatically
# uses yfinance (no key required) during market hours, and its own real-data
# replay engine outside market hours.
TWELVEDATA_API_KEY=

# auto | live | replay - "auto" picks based on real market hours (IST)
DATA_PROVIDER=auto

INGEST_INTERVAL_SECONDS=15
